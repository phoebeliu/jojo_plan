{
  "schemaVersion": 1,
  "version": "JP-1.0",
  "templates": {
    "system": [
      {
        "key": "research",
        "dependsOn": [],
        "roles": [
          "researcher",
          "product"
        ],
        "requiredArtifactKinds": [
          "research",
          "decision_log"
        ],
        "gate": "checks"
      },
      {
        "key": "prd",
        "dependsOn": [
          "research"
        ],
        "roles": [
          "product"
        ],
        "requiredArtifactKinds": [
          "prd"
        ],
        "gate": "user_or_provisional"
      },
      {
        "key": "ux",
        "dependsOn": [
          "prd"
        ],
        "roles": [
          "ux"
        ],
        "requiredArtifactKinds": [
          "ux"
        ],
        "gate": "user_or_provisional"
      },
      {
        "key": "briefing",
        "dependsOn": [
          "ux"
        ],
        "roles": [
          "product",
          "architect",
          "developer",
          "tester"
        ],
        "requiredArtifactKinds": [
          "briefing"
        ],
        "gate": "no_blocking_issues"
      },
      {
        "key": "engineering",
        "dependsOn": [
          "briefing"
        ],
        "roles": [
          "architect",
          "tester"
        ],
        "requiredArtifactKinds": [
          "architecture",
          "test_design"
        ],
        "gate": "user_required"
      },
      {
        "key": "implementation",
        "dependsOn": [
          "engineering"
        ],
        "roles": [
          "developer",
          "tester",
          "evaluator"
        ],
        "requiredArtifactKinds": [
          "code_snapshot",
          "test_evidence"
        ],
        "gate": "checks_and_no_major_issues"
      },
      {
        "key": "final-review",
        "dependsOn": [
          "implementation"
        ],
        "roles": [
          "final_reviewer"
        ],
        "requiredArtifactKinds": [
          "review_report"
        ],
        "gate": "user_required"
      },
      {
        "key": "release",
        "dependsOn": [
          "final-review"
